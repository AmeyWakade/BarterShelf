{
  "expo": {
    "name": "BarterShelf",
    "slug": "bartershelf",
    "scheme": "bartershelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BarterShelf uses your camera to show the live Neighborhood Radar.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose up to four photos for your neighborhood listing.",
          "cameraPermission": "Take photos for your listing."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BarterShelf uses your location to show items within 3 km."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.bartershelf",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "BarterShelf connects to its API on your local Wi-Fi network."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ameywakade.bartershelf",
      "versionCode": 1
    }
  }
}
